# Copy to .env — never commit .env

PRIVATE_KEY=0x

# Alchemy (or any Base Sepolia JSON-RPC HTTPS URL)
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Optional mainnet
# BASE_MAINNET_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# ERC-20 for attester stake and rewards (defaults to Circle USDC on Base / Base Sepolia if unset)
# STAKE_TOKEN_ADDRESS=0x036CBD53842c542663c208eEcbc9E7Bd40E6683B

# Min attester stake in USDC smallest units (default 350 = 0.1 ETH equivalent)
# MIN_STAKE_AMOUNT=350000000

# Base verifier reward per round (default 7 USDC = 0.002 ETH equivalent)
# BASE_REWARD_PER_ROUND_AMOUNT=7000000

# Optional: fund reward pool when running stake:configure-rewards (approve stakeToken first in script)
# REWARD_POOL_FUND_AMOUNT=1000000000

# Optional: contract verification (Etherscan V2 key works for Base/Base Sepolia)
# ETHERSCAN_API_KEY=
# BASESCAN_API_KEY=  # legacy fallback

# After `npm run deploy:aggregate-resolver` — use when registering the on-chain aggregate EAS schema
# ATTESTIA_AGGREGATE_RESOLVER=0x...

# For contributor resolver deployment / schema registration
# ATTESTIA_REGISTRY=0x...
# ATTESTIA_CONTRIBUTOR_RESOLVER=0x...

# For aggregate resolver deployment
# ATTESTIA_STAKE=0x...

# Wallet that signs Attestia native (detector) off-chain score attestations (set on AttestiaStake at deploy)
# ATTESTIA_NATIVE_ATTESTER=0x...
